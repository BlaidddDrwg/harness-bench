import csv
from collections import defaultdict

# Read expenses.csv and aggregate by category
category_totals = defaultdict(float)

with open('/home/blaidddrwg/Projects/AI/harness-bench/runs/codex/csv/expenses.csv', 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        category = row['category']
        amount = float(row['amount'])
        category_totals[category] += amount

# Write summary.csv with one row per category
with open('/home/blaidddrwg/Projects/AI/harness-bench/runs/codex/csv/summary.csv', 'w') as f:
    writer = csv.writer(f)
    writer.writerow(['category', 'total'])  # Header row
    for category, total in sorted(category_totals.items()):
        writer.writerow([category, f\"{total:.2f}\"])

print(\"summary.csv created successfully\")
EOF" in /home/blaidddrwg/Projects/AI/harness-bench/runs/codex/csv
