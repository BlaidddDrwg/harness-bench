import csv
from collections import defaultdict

# Read expenses.csv
with open('/home/blaidddrwg/Projects/AI/harness-bench/runs/opencode/csv/expenses.csv', 'r') as f:
    reader = csv.DictReader(f)
    totals = defaultdict(float)
    for row in reader:
        category = row['category']
        amount = float(row['amount'])
        totals[category] += amount

# Write summary.csv with two decimal places
with open('/home/blaidddrwg/Projects/AI/harness-bench/runs/opencode/csv/summary.csv', 'w', newline='') as f:
    writer = csv.writer(f)
    writer.writerow(['category', 'total'])
    for category in sorted(totals.keys()):
        writer.writerow([category, f"{totals[category]:.2f}"])

print("Created summary.csv")
EOF
