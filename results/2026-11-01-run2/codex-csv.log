# Write the summary CSV
with open('/home/blaidddrwg/Projects/AI/harness-bench/runs/codex/csv/summary.csv', 'w', newline='') as f:
    writer = csv.writer(f)
    writer.writerow(['category', 'total'])
    for category, total in sorted(expenses.items()):
        writer.writerow([category, f'{total:.2f}'])

