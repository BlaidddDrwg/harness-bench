import csv
from collections import defaultdict

# Read expenses.csv
expenses = []
with open('/home/blaidddrwg/Projects/AI/harness-bench/runs/opencode/csv/expenses.csv', 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        category = row['category']
        amount = float(row['amount'])
        expenses.append((category, amount))

# Calculate totals per category
totals = defaultdict(float)
for category, amount in expenses:
    totals[category] += amount

# Write summary.csv
with open('/home/blaidddrwg/Projects/AI/harness-bench/runs/opencode/csv/summary.csv', 'w', newline='') as f:
    writer = csv.writer(f)
    writer.writerow(['category', 'total'])
    for category, total in sorted(totals.items()):
        writer.writerow([category, f'{total:.2f}'])

print('summary.csv written successfully')
EOF
